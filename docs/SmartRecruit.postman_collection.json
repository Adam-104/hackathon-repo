      "url": "{{baseUrl}}/api/jobs/1/applications",
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Apply (CANDIDATE)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
