{
 "info": {
  "name": "SmartRecruit AI",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://localhost:8080"
  },
  {
   "key": "token",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Auth",
   "item": [
    {
     "name": "Register candidate",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/auth/register",
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Cara Candidate\",\n  \"email\": \"cara@example.com\",\n  \"password\": \"Passw0rd!x\",\n  \"role\": \"CANDIDATE\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('token', pm.response.json().token);"
        ]
       }
      }
     ]
    },
    {
     "name": "Register recruiter",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/auth/register",
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Rita HR\",\n  \"email\": \"rita@example.com\",\n  \"password\": \"Passw0rd!x\",\n  \"role\": \"RECRUITER\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('token', pm.response.json().token);"
        ]
       }
      }
     ]
    },
    {
     "name": "Login",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/auth/login",
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"rita@example.com\",\n  \"password\": \"Passw0rd!x\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set('token', pm.response.json().token);"
        ]
       }
      }
     ]
    },
    {
     "name": "Me",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/auth/me",
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    }
   ]
  },
  {
   "name": "Jobs",
   "item": [
    {
     "name": "List/search jobs",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/jobs?q=java",
      "auth": {
       "type": "noauth"
      }
     }
    },
    {
     "name": "Job by id",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/jobs/1",
      "auth": {
       "type": "noauth"
      }
     }
    },
    {
     "name": "Create job (RECRUITER)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/jobs",
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"title\": \"Java Developer\",\n  \"company\": \"Acme\",\n  \"location\": \"Hyderabad\",\n  \"description\": \"Build Spring Boot services\",\n  \"requiredSkills\": \"Java, Spring Boot, MySQL\",\n  \"experienceLevel\": \"Junior\"\n}"
      }
     }
    },
    {
     "name": "My jobs (RECRUITER)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/jobs/mine",
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Close job",
     "request": {
      "method": "PATCH",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
