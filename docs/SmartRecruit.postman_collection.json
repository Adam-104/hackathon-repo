    {
     "name": "Upload resume (PDF/TXT)",
     "request": {
      "method": "POST",
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
