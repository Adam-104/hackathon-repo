       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"status\": \"CLOSED\"\n}"
      }
     }
    },
    {
     "name": "Applicants (RECRUITER)",
     "request": {
      "method": "GET",
      "header": [
