      "body": {
       "mode": "formdata",
       "formdata": [
        {
         "key": "file",
         "type": "file",
         "src": []
        }
       ]
      },
      "url": "{{baseUrl}}/api/candidate/resume"
     }
    },
    {
     "name": "My applications",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/applications/mine",
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{token}}",
         "type": "string"
        }
       ]
      }
